<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- [手錶 v0，v25.573] 手錶 App（com.lifegood.app.watchkitapp）。跟 GENERATE_INFOPLIST_FILE 合併。
	     陣列、字典型的鍵一律寫在這個檔（v25.533 的教訓）；字串型的也寫一份，保險。
	     版號用變數：MARKETING_VERSION／CURRENT_PROJECT_VERSION 只寫在 pbxproj 的專案層，四個 target 一定同號。
	     WKApplication＋WKCompanionAppBundleIdentifier：單一 target 的手錶 App、依附 iPhone 的 LifeGood
	     （照 Apple 範例 SimpleWatchConnectivity Watch App/Info.plist）。不寫 WKRunsIndependentlyOfCompanionApp＝依附型。
	     [手錶 v4，v25.580] 加 WKBackgroundModes（workout-processing：運動 session 整段在背景活著）、UIBackgroundModes（audio：
	     運動中每公里講一句、震動；HealthKit「Running workout sessions」原話，鍵名照 Apple 範例 MirroringWorkoutsSample）、
	     NSLocationTemporaryUsageDescriptionDictionary（字典型：準備頁「這一次給精確位置」，RouteRecorder 用鍵 RunRoute；
	     跟 iPhone LifeGood/Info.plist 一字不差）。**不加** UIBackgroundModes 的 location：手錶不設 allowsBackgroundLocationUpdates
	     （watch/judge.md §5.7、§7.2、§7.8-16）。健康、位置那三句說明字是字串型，照現有慣例寫在 pbxproj 的 INFOPLIST_KEY_。
	     程式裡照 iPhone 先檢查打包出來的真的有（WatchRunVoice.hasAudioBackgroundMode、RouteRecorder.hasPreciseLocationPurpose），
	     沒有就只震動／不問精確位置，不閃退。 -->
	<key>CFBundleDisplayName</key>
	<string>LifeGood</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>RunRoute</key>
		<string>要畫出你跑過的路需要精確位置；只給大約位置會差一兩公里，線畫不出來。</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>WKApplication</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.lifegood.app</string>
</dict>
</plist>
